{
  "name": "ops-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "tsx server/index.ts",
    "dev:all": "concurrently \"npm:dev:api\" \"npm:dev\"",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@vitejs/plugin-basic-ssl": "^2.0.0",
    "amqplib": "^2.0.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "kafkajs": "^2.2.4",
    "stompit": "^1.0.0",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/stompit": "^0.26.6",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
